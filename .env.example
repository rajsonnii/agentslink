# ==========================================
# Agent Slink - Environment Configuration
# ==========================================

# Database (PostgreSQL)
POSTGRES_USER=slink
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=slink

# Slink Core API
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Public URLs (configured in Coolify for Traefik routing & SSL)
# Example: https://slink-api.yourvps.com
NEXT_PUBLIC_SLINK_API_URL=https://slink-api.yourvps.com
# Example: https://slink.yourvps.com
NEXT_PUBLIC_WEB_URL=https://slink.yourvps.com

# ==========================================
# AI Provider (OpenRouter - Recommended & Affordable)
# ==========================================
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# Affordable, high-performance coding model:
# Default: google/gemini-2.0-flash-001 (~$0.10 / 1M tokens)
# Alternative affordable options:
# - deepseek/deepseek-chat (~$0.14 / 1M tokens)
# - meta-llama/llama-3.3-70b-instruct (~$0.12 / 1M tokens)
# - qwen/qwen-2.5-coder-32b-instruct (~$0.18 / 1M tokens)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Alternative Direct Providers (Optional if OPENROUTER_API_KEY is provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub App Integration (Optional for local testing, required for automated GitHub PRs)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
