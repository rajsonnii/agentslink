# ==========================================
# Agent Slink Web Dashboard - Next.js Standalone
# ==========================================
FROM node:22-bookworm-slim AS base

WORKDIR /app

# ------------------------------------------
# Stage 1: Install & Build
# ------------------------------------------
FROM base AS builder

COPY . .

RUN npm install
RUN npm run --workspace=@slink/shared build
RUN npm run --workspace=@slink/web build

# ------------------------------------------
# Stage 2: Production Standalone Runner
# ------------------------------------------
FROM base AS runner

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

WORKDIR /app

# Standalone server files produced by Next.js
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://localhost:3000').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "apps/web/server.js"]
