# ==========================================
# Agent Slink Web Dashboard - Next.js Standalone
# ==========================================
FROM node:22-bookworm-slim AS base

WORKDIR /app

# ------------------------------------------
# Stage 1: Install & Build
# ------------------------------------------
FROM base AS builder

COPY package*.json ./
COPY tsconfig.base.json ./

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

RUN npm install
RUN npm run --workspace=@slink/shared build
RUN npm run --workspace=@slink/web build

# ------------------------------------------
# Stage 2: Production Standalone Runner
# ------------------------------------------
FROM base AS runner

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

WORKDIR /app

# Standalone server files produced by Next.js
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
