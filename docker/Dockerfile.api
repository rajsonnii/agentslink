# ==========================================
# Agent Slink API - Multi-Stage Production Build
# ==========================================
FROM node:22-bookworm-slim AS base

WORKDIR /app

# Install git and bash needed by the AI repair agent for git diff/branch operations
RUN apt-get update && apt-get install -y --no-install-recommends git bash ca-certificates && rm -rf /var/lib/apt/lists/*

# ------------------------------------------
# Stage 1: Build Dependencies and TypeScript
# ------------------------------------------
FROM base AS builder

COPY package*.json ./
COPY tsconfig.base.json ./

# Copy packages and services
COPY packages/shared ./packages/shared
COPY packages/cli ./packages/cli
COPY packages/browser-watcher ./packages/browser-watcher
COPY packages/agent ./packages/agent
COPY services/api ./services/api

# Install all dependencies and build
RUN npm install
RUN npm run --workspace=@slink/shared build
RUN npm run --workspace=@slink/agent build
RUN npm run --workspace=@slink/browser-watcher build
RUN npm run --workspace=@slink/api build

# ------------------------------------------
# Stage 2: Production Runner
# ------------------------------------------
FROM base AS runner

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

WORKDIR /app

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/packages/agent ./packages/agent
COPY --from=builder /app/packages/browser-watcher ./packages/browser-watcher
COPY --from=builder /app/services/api ./services/api

EXPOSE 4000

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://localhost:4000/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "services/api/dist/index.js"]
